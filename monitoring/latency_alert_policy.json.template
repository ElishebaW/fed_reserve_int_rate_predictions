{
  "displayName": "Fed Rate Endpoint High Prediction Latency",
  "combiner": "OR",
  "conditions": [
    {
      "displayName": "Endpoint P95 prediction latency > 2s (10m)",
      "conditionThreshold": {
        "filter": "metric.type=\"aiplatform.googleapis.com/endpoint/prediction_latencies\" resource.type=\"aiplatform.googleapis.com/Endpoint\" resource.label.\"endpoint_id\"=\"__ENDPOINT_ID__\"",
        "aggregations": [
          {
            "alignmentPeriod": "300s",
            "perSeriesAligner": "ALIGN_PERCENTILE_95",
            "crossSeriesReducer": "REDUCE_NONE"
          }
        ],
        "comparison": "COMPARISON_GT",
        "thresholdValue": 2000,
        "duration": "600s",
        "trigger": {
          "count": 1
        }
      }
    }
  ],
  "alertStrategy": {
    "autoClose": "1800s"
  },
  "enabled": true
}
